# counts: url_password=2
user.name=Deploy Bot
user.email=deploy@example.com
core.editor=vim
credential.helper=store
init.defaultbranch=main
pull.rebase=false
url.https://deploy:[REDACTED:url_password]@git.example.com/.insteadof=https://git.example.com/
remote.origin.url=https://x-access-token:[REDACTED:url_password]@github.com/example/mwtn.git
remote.origin.fetch=+refs/heads/*:refs/remotes/origin/*
branch.main.remote=origin
branch.main.merge=refs/heads/main
